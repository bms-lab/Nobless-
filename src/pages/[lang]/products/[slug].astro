---
import Base from '../../../layouts/Base.astro';
import { LANGS, t, type Lang } from '../../../i18n/strings';
import { href, products, articles, fmtDate, site, isRealKey } from '../../../lib/content';
export function getStaticPaths() {
  return LANGS.flatMap((lang) => products.map((p) => ({ params: { lang, slug: p.slug }, props: { product: p } })));
}
const lang = Astro.params.lang as Lang;
const { product } = Astro.props;
const s = t(lang);
const ps = s.products;
const copy = product[lang];
const updates = articles(lang).filter((a) => a.product === product.slug);
const contactOpen = isRealKey(site.web3formsKey) || !!site.contactEmail;
---
<Base lang={lang} title={`${product.name} ${ps.by} | ${copy.oneLiner}`} description={copy.purpose} path={`products/${product.slug}/`} current="products">
  <section class="wrap page-head">
    <a class="back" href={href(lang, 'products')}><span class="arrow" aria-hidden="true">←</span> {ps.back}</a>
    <span class={`status status--${product.status}`}>{s.status[product.status as keyof typeof s.status]}</span>
    <h1>{product.name} <span class="by">{ps.by}</span></h1>
    <p class="lead">{copy.oneLiner}</p>
  </section>
  <section class="wrap">
    <div class="dl">
      <div><span class="label">{ps.purpose}</span><p class="lead">{copy.purpose}</p></div>
      <div><span class="label">{ps.who}</span><p class="lead">{copy.who}</p></div>
      <div><span class="label">{ps.where}</span><p class="lead">{copy.where}</p></div>
      <div><span class="label">{ps.next}</span><p class="lead">{copy.next}</p></div>
      <div><span class="label">{ps.updates}</span>
        {updates.length ? (
          <ul class="list-plain">{updates.map((a) => <li><a href={href(lang, `journal/${a.slug}`)}>{a.title}</a> <span class="muted">· {fmtDate(a.date, lang)}</span></li>)}</ul>
        ) : <p class="muted">{ps.noUpdates}</p>}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="wrap"><div class="cta">
      {contactOpen ? (
        <>
          <h2>{ps.cta}</h2>
          <p class="lead">{ps.ctaBody}</p>
          <a class="btn btn--primary" href={href(lang, 'contact') + `?topic=${product.slug}`}>{s.nav.contact} <span class="arrow" aria-hidden="true">→</span></a>
        </>
      ) : (
        <>
          <h2>{ps.ctaOffTitle}</h2>
          <p class="lead">{ps.ctaOffBody}</p>
          <a class="btn btn--primary" href={href(lang, 'journal')}>{s.home.closingJournal} <span class="arrow" aria-hidden="true">→</span></a>
        </>
      )}
    </div></div>
  </section>
</Base>
<style>
  .back { color: var(--color-text-muted); text-decoration: none; display: inline-flex; gap: 8px; width: fit-content; }
  .back:hover { color: var(--color-text); }
  [dir='rtl'] .back .arrow { display: inline-block; transform: scaleX(-1); }
  .by { font-family: var(--font-mono); font-size: var(--text-label); letter-spacing: 0.08em; color: var(--color-text-muted); vertical-align: middle; }
  .cta { display: grid; gap: 24px; justify-items: start; max-width: 60ch; }
  .dl a { color: var(--color-ion); }
</style>
