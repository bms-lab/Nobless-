---
import Base from '../../../layouts/Base.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { t, langPaths, type Lang } from '../../../i18n/strings';
import { products } from '../../../lib/content';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const s = t(lang);
---
<Base lang={lang} title={s.meta.productsTitle} description={s.meta.productsDesc} path="products/" current="products">
  <section class="wrap page-head">
    <span class="label label--aurum">{s.products.title}</span>
    <h1 class="settle">{s.products.title}</h1>
    <p class="lead">{s.products.lead}</p>
    <div class="legend" aria-hidden="true">
      {(['live', 'development', 'exploring'] as const).map((k) => <span class={`status status--${k}`}>{s.status[k]}</span>)}
    </div>
  </section>
  <section class="wrap list">
    {products.map((p) => <ProductCard lang={lang} product={p} level={2} />)}
    <div class="next"><span class="label">{s.home.nextProduct}</span><p class="muted">{s.home.nextProductBody}</p></div>
  </section>
</Base>
<style>
  .legend { display: flex; flex-wrap: wrap; gap: 10px; margin-top: var(--space-3); }
  .list { display: grid; gap: var(--space-4); padding-bottom: var(--section-y); }
  .next { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-6); align-items: baseline; padding: var(--space-5) clamp(24px, 4vw, 56px); border: 1px dashed var(--color-line-strong); border-radius: var(--radius-lg); }
</style>
