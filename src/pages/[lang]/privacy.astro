---
import Base from '../../layouts/Base.astro';
import { t, langPaths, type Lang } from '../../i18n/strings';
import { site, isRealKey, fmtDate } from '../../lib/content';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const s = t(lang);
const p = s.privacy;
// Update this date whenever the text or the services used change.
const updated = '2026-10-19';
const formOn = isRealKey(site.web3formsKey);
const B = p.blocks;
const blocks = [
  B.collects,
  site.hosting && { ...B.hosting, p: B.hosting.p.replace('{host}', site.hosting) },
  formOn && { ...B.form, p: B.form.p.replace('{form}', site.formProvider || 'Web3Forms') },
  (formOn || site.contactEmail) && B.rights,
  B.changes,
].filter(Boolean) as { h: string; p: string }[];
---
<Base lang={lang} title={s.meta.privacyTitle} description={s.meta.privacyDesc} path="privacy/">
  <section class="wrap page-head">
    <span class="label label--aurum">{p.title}</span>
    <h1>{p.title}</h1>
    <p class="lead">{p.lead}</p>
  </section>
  <section class="wrap">
    <div class="dl">
      {blocks.map((b) => <div><span class="label">{b.h}</span><p class="lead">{b.p}</p></div>)}
    </div>
    <p class="muted upd">{p.updated}: {fmtDate(updated, lang)}</p>
  </section>
</Base>
<style>.upd { padding-block: 32px clamp(64px, 10vw, 160px); border-top: 1px solid var(--color-line); }</style>
