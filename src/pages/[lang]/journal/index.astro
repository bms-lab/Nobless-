---
import Base from '../../../layouts/Base.astro';
import { t, langPaths, type Lang } from '../../../i18n/strings';
import { href, articles, fmtDate } from '../../../lib/content';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const s = t(lang);
const j = s.journal;
const list = articles(lang);
const cats = [...new Set(list.map((a) => a.category))];
---
<Base lang={lang} title={s.meta.journalTitle} description={s.meta.journalDesc} path="journal/" current="journal">
  <section class="wrap page-head">
    <span class="label label--aurum">{j.title}</span>
    <h1>{j.title}</h1>
    <p class="lead">{j.lead}</p>
  </section>
  <section class="wrap body">
    {list.length === 0 ? (
      <div class="card empty"><h2 class="empty__t">{j.empty}</h2><p class="muted">{j.emptyBody}</p></div>
    ) : (
      <>
        {cats.length > 1 && (
          <div class="chips" role="group" aria-label={j.title} data-chips>
            <button type="button" aria-pressed="true" data-cat="">{j.all}</button>
            {cats.map((c) => <button type="button" aria-pressed="false" data-cat={c}>{j.categories[c]}</button>)}
          </div>
        )}
        <ul class="arts">
          {list.map((a) => (
            <li data-cat={a.category}>
              <a href={href(lang, `journal/${a.slug}`)} class="art">
                <span class="label">{fmtDate(a.date, lang)} · {j.categories[a.category]} · {j.statusTags[a.status]}</span>
                <h2 class="art__t">{a.title}</h2>
                <p class="muted">{a.excerpt}</p>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}
  </section>
</Base>
<style>
  .body { padding-bottom: clamp(64px, 10vw, 160px); }
  .empty { padding: clamp(32px, 5vw, 64px); }
  .empty__t { font-size: var(--text-h3); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 32px; }
  .chips button { font: inherit; font-size: 0.9rem; color: var(--color-text-muted); background: none; border: 1px solid var(--color-line-strong); border-radius: 999px; padding: 6px 16px; cursor: pointer; min-height: 40px; }
  .chips button[aria-pressed='true'] { background: var(--color-text); color: var(--color-bg); border-color: var(--color-text); }
  .arts { list-style: none; margin: 0; padding: 0; }
  .arts li { border-top: 1px solid var(--color-line); }
  .arts li:last-child { border-bottom: 1px solid var(--color-line); }
  .art { display: grid; gap: 12px; padding-block: 32px; text-decoration: none; }
  .art__t { font-size: var(--text-h3); font-weight: 500; transition: color var(--dur-fast); }
  .art:hover .art__t { color: var(--color-ion-strong); }
</style>
<script>
  const chips = document.querySelector('[data-chips]');
  chips?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button');
    if (!b) return;
    chips.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    const cat = b.dataset.cat;
    document.querySelectorAll<HTMLElement>('.arts li').forEach((li) => { li.hidden = !!cat && li.dataset.cat !== cat; });
  });
</script>
